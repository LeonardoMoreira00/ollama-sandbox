# Modelfile.example
# A Modelfile customizes a base model's behavior.
#
# Usage:
#   ollama create my-assistant -f config/Modelfile.example
#   ollama run my-assistant

# Base model to build on
FROM llama3.2

# System prompt — sets the model's persona and rules
SYSTEM """
You are a helpful Linux assistant specializing in Fedora.
Answer concisely. Prefer shell commands over long explanations.
When showing commands, use code blocks.
"""

# Sampling parameters
PARAMETER temperature 0.7       # Creativity: 0.0 (deterministic) to 1.0 (creative)
PARAMETER top_p 0.9             # Nucleus sampling threshold
PARAMETER top_k 40              # Limit next-token candidates
PARAMETER num_ctx 4096          # Context window size (tokens)
PARAMETER repeat_penalty 1.1    # Penalize repeated phrases
