# Ollama Environment Configuration
# Place this file at /etc/ollama/ollama.env
# Then restart: sudo systemctl restart ollama

# --- Network ---

# Address and port Ollama listens on
# Default: 127.0.0.1:11434 (localhost only)
# Set to 0.0.0.0:11434 to expose on all interfaces (LAN access)
OLLAMA_HOST=127.0.0.1:11434

# Allowed origins for CORS (useful when accessing from a browser/frontend)
# OLLAMA_ORIGINS=http://localhost:3000,http://192.168.1.0/24

# --- Models ---

# Directory where models are stored
# Default: ~/.ollama/models
OLLAMA_MODELS=/usr/share/ollama/.ollama/models

# --- Performance ---

# Number of layers to offload to GPU (default: auto-detect)
# Set to 0 to force CPU-only mode
# OLLAMA_NUM_GPU=0

# Max number of parallel requests (default: 1)
OLLAMA_NUM_PARALLEL=2

# How long (in minutes) a model stays loaded after last use (default: 5)
# Set to -1 to keep model loaded indefinitely
OLLAMA_KEEP_ALIVE=5

# --- Logging ---

# Log level: debug, info, warn, error (default: info)
OLLAMA_LOG_LEVEL=info

# --- Debug ---

# Enable verbose debug output
OLLAMA_DEBUG=1
